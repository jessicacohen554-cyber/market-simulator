# API keys for scripts/data/fetch_* — copy this file to .env and fill in values.
# .env is untracked (see .gitignore §2); this template lists key NAMES only.
# Keys resolve at runtime via scripts/lib/env_keys.py (env var first, then .env).
# Register free keys at the portals noted below. Never commit real values.

# EIA Open Data API v2 — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# MISO Data Exchange, pricing subscription key — https://apim.misoenergy.org
MISO_PRICING_API_KEY=

# MISO Data Exchange, load subscription key — https://apim.misoenergy.org
MISO_LOAD_API_KEY=

# ERCOT Public API subscription key — https://apiexplorer.ercot.com
ERCOT_API_KEY=

# data.gov API key — https://api.data.gov/signup
DATA_GOV_API_KEY=
