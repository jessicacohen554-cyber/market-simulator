+def _load_ercot_steam_online_span_tables(
+    config: ScenarioConfig,
+    year: int,
+    wall_edges: tuple[float, ...],
+    hours: int,
+) -> "tuple[dict[str, np.ndarray], np.ndarray, np.ndarray]":
+    """Resolve the ERCOT-93 ST_GAS conditional online-span artifact for ``year``.
+
+    The steam analogue of :func:`_load_ercot_online_span_tables`: returns
+    ``({"ST": table}, season_idx, block_idx)`` from
+    ``scripts/data/derive_ercot_shoulder_online_span_steam.py`` (its OWN
+    artifact, rule 19). Cells the corpus never covers (null) resolve to
+    **1.0** — full-span geometry, mechanism inert there. A year absent from the
+    artifact returns ``({}, ...)`` — the caller keeps the "ST" rows byte-
+    identical (YEAR-SCOPED, rule 13: no pooled fallback).
+    """
+    span_path = getattr(config, "ercot_shoulder_online_span_steam_path", None)
+    if not span_path:
+        from market_sim.config import paths as _paths
+
+        span_path = str(
+            _paths.CALIBRATION_DIR / "ercot_shoulder_online_span_steam_condbinned.json"
+        )
+    surface = json.loads(Path(span_path).read_text())
+    prov = surface.get("_provenance", {})
+    edges = tuple(float(x) for x in prov.get("netload_pct_edges", ()))
+    season_of_month = [int(x) for x in prov.get("season_of_month", ())]
+    block_h = int(prov.get("hour_block_hours", 0))
+    if edges != tuple(wall_edges):
+        raise ValueError(
+            "ercot_shoulder_online_span_steam: span artifact bin edges "
+            f"{edges} != cleared-share wall edges {tuple(wall_edges)} — "
+            "re-derive scripts/data/derive_ercot_shoulder_online_span_steam.py"
+        )
+    if len(season_of_month) != 12 or block_h <= 0:
+        raise ValueError(
+            "ercot_shoulder_online_span_steam: span artifact carries no "
+            "season_of_month/hour_block_hours — re-derive "
+            "scripts/data/derive_ercot_shoulder_online_span_steam.py"
+        )
+    month_start_h = np.cumsum([0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30]) * 24
+    hoy = np.arange(hours)
+    month_idx = np.searchsorted(month_start_h[1:], hoy % 8760, side="right")
+    season_idx = np.asarray(season_of_month, dtype=int)[month_idx]  # (hours,)
+    block_idx = (hoy % 24) // block_h  # (hours,)
+
+    tables: dict[str, np.ndarray] = {}
+    tbl = surface.get("ST", {}).get("years", {}).get(str(year))
+    if tbl:
+        span = np.array(
+            [
+                [[np.nan if v is None else float(v) for v in row] for row in mat]
+                for mat in tbl.get("span", ())
+            ],
+            dtype=float,
+        )
+        if span.ndim == 3 and span.shape[0] == len(edges) + 1:
+            # Uncovered cells -> 1.0: full-span geometry, mechanism inert there.
+            tables["ST"] = np.nan_to_num(span, nan=1.0)
+    if not tables:
+        logger.info(
+            "ERCOT steam online span (ERCOT-93): year %s absent from the steam "
+            "span artifact — full-span steam wall geometry retained byte-"
+            "identical (year-scoped, rule 13)",
+            year,
+        )
+    return tables, season_idx, block_idx
+
+
