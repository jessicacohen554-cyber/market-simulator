@@ -0,0 +1,160 @@
+"""Derive the PJM gas-CC commitment-bridge min-load fraction + overnight evidence.
+
+The PJM analogue of the ERCOT ``ercot_gas_bridge_min_load_frac`` derive
+(``derive_ercot_thermal_dam_availability`` family, 60-Day DAM disclosure): for
+the M-3 overnight commitment bridge
+(``ScenarioConfig.pjm_gas_commitment_bridge``,
+``docs/DIAGNOSIS-pjm-2025-phase-drift-and-zonal-structure-2026-07.md`` §6) the
+one parameter the mechanism needs is ``min_load_frac`` — a bridged CC's minimum
+stable load as a fraction of its available capacity.
+
+Source: the PJM DataMiner2 ``energy_market_offers`` feed
+(``data/raw/pjm-energy-offers/pjm_energy_offers_<year>_<month>.parquet``,
+``scripts/fetch_pjm_energy_offers.py``). Each row is one (unit_code x
+operating-hour) offer carrying ``avg_ecomin`` / ``avg_ecomax`` (the unit's
+economic min/max = committed LSL/HSL) plus the commitment-physics fields
+(``min_runtime``, ``no_load_cost``, start costs).
+
+``min_load_frac`` = the capacity-weighted p50 of ``avg_ecomin / avg_ecomax``
+over the CC-like segment, where CC-like is selected by unit PHYSICS (never fuel
+— the offers carry no fuel label; the unit_code is hashed) using the SAME
+frozen segmentation as ``scripts/derive_pjm_offer_surface.py`` (the G-22 §2
+segmentation): per-unit median ``min_runtime`` in
+``(FAST_START_MAX_MIN_RUNTIME_H, CC_MAX_MIN_RUNTIME_H]`` h AND median
+``ecomin/ecomax`` > ``CC_MIN_ECOMIN_RATIO``, excluding nuclear-like baseload
+(median ratio >= ``NUCLEAR_ECOMIN_RATIO`` AND EcoMax >= ``NUCLEAR_MIN_ECOMAX_MW``)
+and zero-offer hydro/PS/storage (median top-of-curve < ``ZERO_TOP_FLOOR_USD``).
+
+Overnight committed-state evidence (the M-3 D-4 justification): the fraction of
+CC-segment unit-hours that carry a positive ``avg_ecomin`` floor, by EPT hour —
+committed CC units bidding an LSL floor through the overnight hours is the
+market-side evidence that the class holds min-load rather than cycling cold
+overnight (the model-side D-1p flat-overnight residual, diagnosis §4/§6).
+
+Provenance / admissibility (CLAUDE.md rules 13/18/23): ``avg_ecomin`` /
+``avg_ecomax`` are PJM-published, unit-resolved MW capability quantities — a
+physical/market min-stable-load measurement, never a price. The bridge reads
+only the derived SCALAR (like the ERCOT 0.574); no measured series enters the
+solve, and the mechanism regenerates in a forecast year from the model's own P0
+run pattern + physical constants. FROZEN AGAINST RESIDUALS (rule 23): re-derive
+only when the offers corpus updates; never because a residual moved.
+
+Usage::
+
+    python scripts/derive_pjm_gas_bridge_params.py [--months-glob '*2024*'] [--json OUT]
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+REPO = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO / "scripts"))
+
+RAW_DIR = REPO / "data" / "raw" / "pjm-energy-offers"
+OUT_JSON = REPO / "data" / "raw" / "_validation-source" / "pjm_gas_bridge_params.json"
+
+_BID_COLS = [f"bid{i}" for i in range(1, 21)]
+
+
+def _load_offers(pattern: str) -> pd.DataFrame:
+    files = sorted(glob.glob(str(RAW_DIR / pattern)))
+    if not files:
+        raise SystemExit(
+            f"no offer parquets match {RAW_DIR / pattern} — run "
+            "scripts/fetch_pjm_energy_offers.py first"
+        )
+    frames = [pd.read_parquet(f) for f in files]
+    df = pd.concat(frames, ignore_index=True)
+    df["top"] = df[_BID_COLS].max(axis=1)
+    df["ratio"] = df["avg_ecomin"] / df["avg_ecomax"].replace(0, np.nan)
+    return df, [Path(f).name for f in files]
+
+
+def _cc_segment(df: pd.DataFrame):
+    """Return (per-unit frame, boolean CC-like mask) via the frozen segmentation."""
+    from derive_pjm_offer_surface import (
+        CC_MAX_MIN_RUNTIME_H,
+        CC_MIN_ECOMIN_RATIO,
+        FAST_START_MAX_MIN_RUNTIME_H,
+        NUCLEAR_ECOMIN_RATIO,
+        NUCLEAR_MIN_ECOMAX_MW,
+        ZERO_TOP_FLOOR_USD,
+    )
+
+    g = df.groupby("unit_code").agg(
+        med_minrun=("min_runtime", "median"),
+        med_ratio=("ratio", "median"),
+        med_ecomax=("avg_ecomax", "median"),
+        med_top=("top", "median"),
+        n=("unit_code", "size"),
+    )
+    cc = (
+        (g["med_minrun"] > FAST_START_MAX_MIN_RUNTIME_H)
+        & (g["med_minrun"] <= CC_MAX_MIN_RUNTIME_H)
+        & (g["med_ratio"] > CC_MIN_ECOMIN_RATIO)
+    )
+    nuke = (g["med_ratio"] >= NUCLEAR_ECOMIN_RATIO) & (
+        g["med_ecomax"] >= NUCLEAR_MIN_ECOMAX_MW
+    )
+    zerotop = g["med_top"] < ZERO_TOP_FLOOR_USD
+    return g, (cc & ~nuke & ~zerotop)
+
+
+def _cap_weighted_p50(ratio: np.ndarray, weight: np.ndarray) -> float:
+    order = np.argsort(ratio)
+    rs, ws = ratio[order], weight[order]
+    cum = np.cumsum(ws) / ws.sum()
+    return float(np.interp(0.5, cum, rs))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--months-glob", default="pjm_energy_offers_*.parquet")
+    ap.add_argument("--json", default=str(OUT_JSON))
+    args = ap.parse_args()
+
+    df, files = _load_offers(args.months_glob)
+    g, cc_sel = _cc_segment(df)
+    ccg = g[cc_sel]
+    r = ccg["med_ratio"].to_numpy(float)
+    w = ccg["med_ecomax"].to_numpy(float)
+    p50 = _cap_weighted_p50(r, w)
+
+    # Overnight committed-state evidence: CC unit-hours with ecomin>0 by EPT hour.
+    hours = pd.to_datetime(df["bid_datetime_beginning_ept"], errors="coerce").dt.hour
+    cc_mask = df["unit_code"].isin(set(ccg.index))
+    by_hour = (
+        (df.loc[cc_mask, "avg_ecomin"] > 0)
+        .groupby(hours[cc_mask])
+        .mean()
+        .reindex(range(24))
+    )
+
+    out = {
+        "min_load_frac": round(p50, 3),
+        "n_cc_units": int(cc_sel.sum()),
+        "cc_ecomax_mw_total": round(float(ccg["med_ecomax"].sum())),
+        "ratio_quartiles": [round(float(q), 3) for q in np.percentile(r, [25, 50, 75])],
+        "overnight_ecomin_positive_frac_h0_6": round(float(by_hour.loc[0:6].mean()), 3),
+        "midday_ecomin_positive_frac_h12_18": round(
+            float(by_hour.loc[12:18].mean()), 3
+        ),
+        "source_files": files,
+        "segmentation": "derive_pjm_offer_surface physics thresholds (frozen)",
+    }
+    print(json.dumps(out, indent=2))
+    Path(args.json).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.json).write_text(json.dumps(out, indent=2) + "\n")
+    print(f"\nwrote {args.json}")
+
+
+if __name__ == "__main__":
+    main()
