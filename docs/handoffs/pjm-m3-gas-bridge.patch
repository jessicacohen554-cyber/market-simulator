+def _pjm_gas_bridge_floor(
+    config,
+    fleet: list,
+    fleet_arrays,
+    p0_dispatch: np.ndarray,
+    p0_prices: np.ndarray | None,
+    mc_base: np.ndarray,
+) -> np.ndarray | None:
+    """Compute the raw ``(n_gen, T)`` PJM gas-CC bridge floor (or ``None``).
+
+    The PJM analogue of :func:`_ercot_gas_bridge_floor` — the SAME ISO-neutral
+    detector (:func:`model.commitment.caiso_ra_mustoffer_min_gen`, fed the
+    model's own base-cost P0 run pattern + duals) scoped to the merchant
+    gas-CC fleet (``fuel_types=("gas_cc",)``), reading the PJM bridge config
+    (``pjm_gas_bridge_min_load_frac`` / ``pjm_gas_bridge_startup`` /
+    ``pjm_gas_bridge_da_horizon``). Assumes the caller already checked the
+    ``pjm_gas_commitment_bridge`` + ISO gate. Returns ``None`` when the
+    detector produces no floor.
+    """
+    from market_sim.config.constants import DA_COMMITMENT_HORIZON_HOURS
+    from market_sim.model.commitment import caiso_ra_mustoffer_min_gen, find_runs
+
+    startup_bridge = bool(getattr(config, "pjm_gas_bridge_startup", True))
+    max_gap = (
+        float(DA_COMMITMENT_HORIZON_HOURS)
+        if getattr(config, "pjm_gas_bridge_da_horizon", True)
+        else None
+    )
+    bridge_floor = caiso_ra_mustoffer_min_gen(
+        p0_dispatch,
+        fleet_arrays,
+        fleet,
+        float(config.pjm_gas_bridge_min_load_frac),
+        p1_prices=p0_prices if startup_bridge else None,
+        base_mc=mc_base if startup_bridge else None,
+        startup_bridge=startup_bridge,
+        fuel_types=("gas_cc",),
+        max_econ_gap_hours=max_gap,
+    )
+    if not np.any(bridge_floor > 0.0):
+        return None
+    # Diagnostic trace for the D-4 window / probe analysis: every floored
+    # segment IS a bridged gap, so its length distribution is the direct
+    # evidence the declared window (idle gaps between run-days) is what binds.
+    seg_lengths = [
+        e - s
+        for g in np.flatnonzero((bridge_floor > 0.0).any(axis=1))
+        for s, e in find_runs(bridge_floor[g] > 0.0)
+    ]
+    if seg_lengths:
+        seg = np.array(seg_lengths)
+        buckets = {
+            "<4h": int((seg < 4).sum()),
+            "4-8h": int(((seg >= 4) & (seg < 8)).sum()),
+            "8-16h": int(((seg >= 8) & (seg < 16)).sum()),
+            "16-24h": int(((seg >= 16) & (seg <= 24)).sum()),
+            ">24h": int((seg > 24).sum()),
+        }
+        logger.info(
+            "PJM gas commitment bridge: %d unit-hours floored "
+            "(%.2f TWh floor volume), %d bridged gaps by length %s",
+            int((bridge_floor > 0.0).sum()),
+            float(bridge_floor.sum()) / 1e6,
+            len(seg_lengths),
+            buckets,
+        )
+    return bridge_floor
+
+
+def build_pjm_gas_bridge_p1_prep(config, iso: str, fleet: list, fleet_arrays, mc_base):
+    """Return a ``p1_fleet_prep`` hook for the PJM gas commitment bridge.
+
+    The PJM analogue of :func:`build_ercot_gas_bridge_p1_prep`
+    (``pjm_gas_commitment_bridge``, M-3 — the committed-STATE overnight bridge,
+    docs/DIAGNOSIS-pjm-2025-phase-drift-and-zonal-structure-2026-07.md §6): the
+    ISO-neutral detector (:func:`_pjm_gas_bridge_floor`) scoped to merchant
+    gas-CC with the measured PJM committed-CC LSL/HSL p50 min-load and a
+    DA-operating-day cap on the economic leg. D-2 attribution
+    ``MECH_PJM_GAS_COMMITMENT_BRIDGE`` (its own id — the same phenomenon as the
+    ERCOT bridge, but a separate id keeps per-ISO attribution/ablation
+    independent, the MECH_ST_GAS_MUSTRUN_PER_PLANT precedent). Returns ``None``
+    when the
+    mechanism is off, the ISO is not PJM, or the detector produces no floor, so
+    every other path is byte-identical. ISO-exclusive with the CAISO/ERCOT P1
+    fleet hooks (each gates on its ISO).
+
+    Raises:
+        ValueError: If both ``pjm_gas_commitment_bridge`` and
+            ``pjm_reserve_commitment_scoped`` (path B) are on — both replace
+            the P1 fleet with a masked/floored ``FleetArrays`` on the same PJM
+            fleet (CLAUDE.md rule 19 — one mechanism per phenomenon; enable
+            exactly one).
+    """
+    if not (getattr(config, "pjm_gas_commitment_bridge", False) and iso == "PJM"):
+        return None
+    if getattr(config, "pjm_reserve_commitment_scoped", False):
+        raise ValueError(
+            "pjm_gas_commitment_bridge is mutually exclusive with "
+            "pjm_reserve_commitment_scoped (path B): both replace the P1 fleet "
+            "with a masked/floored FleetArrays (CLAUDE.md rule 19 — one "
+            "mechanism per phenomenon); enable exactly one."
+        )
+
+    from market_sim.data.floor_mechanisms import MECH_PJM_GAS_COMMITMENT_BRIDGE
+
+    def _fleet_prep(r0):
+        bridge_floor = _pjm_gas_bridge_floor(
+            config, fleet, fleet_arrays, r0.dispatch, r0.prices, mc_base
+        )
+        if bridge_floor is None:
+            return None
+        return _bridge_floored_fleet(
+            fleet_arrays, bridge_floor, MECH_PJM_GAS_COMMITMENT_BRIDGE
+        )
+
+    return _fleet_prep
+
+
