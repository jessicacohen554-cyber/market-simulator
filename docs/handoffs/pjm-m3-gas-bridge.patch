@@ -0,0 +1,175 @@
+"""Validation of the PJM gas-CC commitment bridge (M-3).
+
+Covers :func:`market_sim.pipeline.commitment.build_pjm_gas_bridge_p1_prep` — the
+PJM analogue of the ERCOT gas commitment bridge (the CAISO RA must-offer
+internals routed onto the PJM merchant gas-CC fleet with the measured PJM
+committed-CC LSL/HSL p50 min-load). The shared detector internals themselves
+(``fuel_types`` scope, ``max_econ_gap_hours`` DA-horizon cap on
+:func:`model.commitment.caiso_ra_mustoffer_min_gen`) are exercised by
+``tests/test_ercot_gas_commitment_bridge.py``; this file covers the PJM-gated
+wrapper contract:
+
+* flag off / non-PJM ⇒ ``None`` (byte-identical P1 — rules 14/26);
+* the P1-native prep floors gas-CC only and tags
+  ``MECH_PJM_GAS_COMMITMENT_BRIDGE`` (its own id, distinct from the ERCOT
+  bridge — per-ISO attribution/ablation independence);
+* the startup (economic ≥ min-down) leg and the DA-horizon cap default on;
+* mutual exclusivity with the PJM path-B reserve fleet mask
+  (``pjm_reserve_commitment_scoped``) is enforced loud (rule 19);
+* the mechanism is registered + carries a D-3 ablation decision.
+"""
+
+import unittest
+
+import numpy as np
+
+from market_sim.config.scenarios import ScenarioConfig
+from market_sim.data.fleet import Generator, generators_to_fleet_arrays
+from market_sim.data.floor_mechanisms import (
+    MECH_NAMES,
+    MECH_PJM_GAS_COMMITMENT_BRIDGE,
+    assert_ablation_coverage,
+)
+from market_sim.pipeline.commitment import build_pjm_gas_bridge_p1_prep
+
+
+def _cc_gen(pmax=300.0, heat_rate=7.0, plant_group="CC_REGULAR", fuel="gas_cc"):
+    return Generator(
+        unit_id="CC",
+        name="CC",
+        zone="z",
+        fuel_type=fuel,
+        pmax_mw=pmax,
+        pmin_mw=0.0,
+        heat_rate=heat_rate,
+        eford=0.0,
+        plant_group=plant_group,
+    )
+
+
+def _overnight_dispatch(hours=48):
+    """Two run-days with an 8 h overnight gap (>= the f-class 6 h min-down)."""
+    disp = np.zeros(hours)
+    disp[6:22] = 300.0  # day 1 run, ends h22
+    disp[30:46] = 300.0  # day 2 run, starts h30 -> gap h22..29 = 8 h
+    return disp
+
+
+class _R0:
+    def __init__(self, dispatch, prices):
+        self.dispatch = dispatch
+        self.prices = prices
+
+
+class TestPjmGasBridgePrep(unittest.TestCase):
+    """The PJM-gated P1-native prep wrapper."""
+
+    def _setup(self, hours=48, **overrides):
+        gen = _cc_gen()
+        fa = generators_to_fleet_arrays([gen], ["z"], hours=hours)
+        cfg = ScenarioConfig(iso="PJM").with_overrides(
+            pjm_gas_commitment_bridge=True, **overrides
+        )
+        p0 = _overnight_dispatch(hours).reshape(1, hours)
+        mc = np.full((1, hours), 30.0)
+        lmp = np.full((1, hours), 25.0)
+        return cfg, [gen], fa, p0, lmp, mc
+
+    def test_gate_off_returns_none(self):
+        cfg, gens, fa, p0, lmp, mc = self._setup()
+        cfg = cfg.with_overrides(pjm_gas_commitment_bridge=False)
+        self.assertIsNone(build_pjm_gas_bridge_p1_prep(cfg, "PJM", gens, fa, mc))
+
+    def test_non_pjm_returns_none(self):
+        cfg, gens, fa, p0, lmp, mc = self._setup()
+        self.assertIsNone(build_pjm_gas_bridge_p1_prep(cfg, "ERCOT", gens, fa, mc))
+
+    def test_overnight_economic_bridge_floors_and_tags(self):
+        # Near-marginal gas: hold (30-25) x 0.564 x 8 = 22.6 < ~48.6 startup ->
+        # the overnight gap is held at min-load; default p50 x pmax = 169.2.
+        cfg, gens, fa, p0, lmp, mc = self._setup()
+        prep = build_pjm_gas_bridge_p1_prep(cfg, "PJM", gens, fa, mc)
+        self.assertIsNotNone(prep)
+        out = prep(_R0(p0, lmp))
+        self.assertIsNotNone(out)
+        np.testing.assert_allclose(out.min_gen[0, 22:30], 0.564 * 300.0)
+        self.assertTrue(np.all(out.min_gen[0, :22] == 0.0))
+        self.assertTrue(
+            np.all(out.min_gen_mechanism[0, 22:30] == MECH_PJM_GAS_COMMITMENT_BRIDGE)
+        )
+        self.assertTrue(np.all(out.min_gen_mechanism[0, :22] == 0))
+        # LP feasibility: availability covers the floor on floored hours.
+        need = out.min_gen[0, 22:30] / 300.0
+        self.assertTrue(np.all(out.availability[0, 22:30] >= need - 1e-12))
+        # Input fleet untouched (dataclasses.replace, not mutation).
+        self.assertTrue(fa.min_gen is None or np.all(fa.min_gen == 0.0))
+
+    def test_startup_leg_off_drops_overnight_gap(self):
+        # The 8 h gap >= the 6 h min-down: the physical bar alone catches
+        # nothing (the ERCOT-62b "physical-only is near-inert" arm).
+        cfg, gens, fa, p0, lmp, mc = self._setup(pjm_gas_bridge_startup=False)
+        prep = build_pjm_gas_bridge_p1_prep(cfg, "PJM", gens, fa, mc)
+        self.assertIsNotNone(prep)
+        self.assertIsNone(prep(_R0(p0, lmp)))
+
+    def test_da_horizon_caps_multiday_gap(self):
+        # A 35 h gap bridges without the horizon and is dropped with it.
+        hours = 72
+        gen = _cc_gen()
+        fa = generators_to_fleet_arrays([gen], ["z"], hours=hours)
+        disp = np.zeros(hours)
+        disp[0:6] = 300.0
+        disp[41:48] = 300.0
+        p0 = disp.reshape(1, hours)
+        mc = np.full((1, hours), 26.0)
+        lmp = np.full((1, hours), 25.0)
+        on = ScenarioConfig(iso="PJM").with_overrides(pjm_gas_commitment_bridge=True)
+        off = on.with_overrides(pjm_gas_bridge_da_horizon=False)
+        self.assertIsNone(
+            build_pjm_gas_bridge_p1_prep(on, "PJM", [gen], fa, mc)(_R0(p0, lmp))
+        )
+        out = build_pjm_gas_bridge_p1_prep(off, "PJM", [gen], fa, mc)(_R0(p0, lmp))
+        self.assertIsNotNone(out)
+        self.assertTrue(np.all(out.min_gen[0, 6:41] > 0.0))
+
+    def test_ct_never_floored(self):
+        # A fast-start CT with the same bridgeable pattern is never touched
+        # (rule-18 physics: min-down < RA_BRIDGE_ECON_MIN_DOWN_HOURS).
+        hours = 48
+        gen = _cc_gen(plant_group="CT_PEAKER", fuel="gas_ct", heat_rate=10.5)
+        fa = generators_to_fleet_arrays([gen], ["z"], hours=hours)
+        cfg = ScenarioConfig(iso="PJM").with_overrides(pjm_gas_commitment_bridge=True)
+        p0 = _overnight_dispatch(hours).reshape(1, hours)
+        lmp = np.full((1, hours), 25.0)
+        mc = np.full((1, hours), 30.0)
+        self.assertIsNone(
+            build_pjm_gas_bridge_p1_prep(cfg, "PJM", [gen], fa, mc)(_R0(p0, lmp))
+        )
+
+    def test_mutual_exclusion_with_path_b_raises(self):
+        # Both replace the P1 fleet on the same PJM fleet — rule 19.
+        cfg, gens, fa, p0, lmp, mc = self._setup(pjm_reserve_commitment_scoped=True)
+        with self.assertRaises(ValueError):
+            build_pjm_gas_bridge_p1_prep(cfg, "PJM", gens, fa, mc)
+
+
+class TestRegistry(unittest.TestCase):
+    def test_mechanism_registered_and_ablated(self):
+        self.assertEqual(
+            MECH_NAMES[MECH_PJM_GAS_COMMITMENT_BRIDGE], "pjm_gas_commitment_bridge"
+        )
+        assert_ablation_coverage()
+        from market_sim.data.floor_mechanisms import MECH_ABLATION_FIELDS
+
+        self.assertEqual(
+            MECH_ABLATION_FIELDS[MECH_PJM_GAS_COMMITMENT_BRIDGE],
+            {"pjm_gas_commitment_bridge": False},
+        )
+        # Distinct id from the ERCOT bridge (per-ISO attribution independence).
+        from market_sim.data.floor_mechanisms import MECH_GAS_COMMITMENT_BRIDGE
+
+        self.assertNotEqual(MECH_PJM_GAS_COMMITMENT_BRIDGE, MECH_GAS_COMMITMENT_BRIDGE)
+
+
+if __name__ == "__main__":
+    main()
