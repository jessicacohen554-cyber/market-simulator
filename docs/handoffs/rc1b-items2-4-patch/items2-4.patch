+
+        # Numerically identical to ERCOT's seasonal_rating (both 1.0) while the
+        # two registry strings stay DISTINCT (the provenance differs — ERCOT:
+        # risk in the target margin; ISO-NE: risk priced ex post via PFP).
+        self.assertEqual(
+            thermal_accreditation_fraction("gas_cc", 0.05, "NEISO"),
