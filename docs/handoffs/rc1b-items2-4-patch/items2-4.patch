+def resolve_demand_curve_vintage(iso: str, year: int) -> "MarketDesign | None":
+    """Resolve the capacity demand-curve vintage for an ISO and CALENDAR year.
+
+    Maps a single model calendar year to a published delivery-year vintage in
+    :data:`MARKET_DESIGN_VINTAGES` and returns that vintage's
+    :class:`MarketDesign`, or ``None`` when the ISO has no vintage table (the
+    caller then falls back to its flat :data:`MARKET_DESIGN` registry entry).
+
+    Mapping convention: a delivery year ``"YYYY/YYYY+1"`` (PJM) or
+    ``"YYYY-YYYY+1"`` (others) spans ~mid-``YYYY`` → mid-``YYYY+1``; the model's
+    single calendar year ``Y`` maps to the delivery year whose FIRST year
+    ``== Y`` (e.g. calendar 2026 → ``"2026/2027"``), the delivery year covering
+    the larger (summer-peak) share of calendar ``Y``.
+
+    Fallbacks on that first-year key:
+
+    * **hold-first** — ``Y`` before the earliest listed vintage returns the
+      earliest (MISO pre-RBDC 2021-2024 → the 2025-2026 vintage).
+    * exact / most-recent — otherwise the vintage with the largest
+      first-year ``≤ Y``.
+    * **hold-last** — ``Y`` after the latest listed vintage returns the latest
+      (the forward hold-last policy).
+    """
+    table = MARKET_DESIGN_VINTAGES.get(iso.upper())
+    if not table:
+        return None
+
+    def _first_year(key: str) -> int:
+        # "2026/2027" or "2026-2027" -> 2026
+        return int(key.replace("/", "-").split("-")[0])
+
+    vintages = sorted(table.items(), key=lambda kv: _first_year(kv[0]))
+    first_years = [_first_year(k) for k, _ in vintages]
+    if year <= first_years[0]:  # hold-first
+        return vintages[0][1]
+    if year >= first_years[-1]:  # hold-last
+        return vintages[-1][1]
+    chosen = vintages[0][1]
+    for (_key, md), fy in zip(vintages, first_years):
+        if fy <= year:
+            chosen = md
+        else:
+            break
+    return chosen
+
