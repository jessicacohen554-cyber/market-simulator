+    def setUpClass(cls):
+        from scripts.lib import capacity_market_demand_curve as dc
+
+        cls.dc = dc
+
+    def _rows(self, iso, delivery_year):
+        df = self.dc.parse_iso(iso, RAW_DIR)
+        return df[df.delivery_year == delivery_year]
+
+    @staticmethod
+    def _scalar(rows, metric, **filt):
+        sub = rows[rows.metric == metric]
+        for col, val in filt.items():
+            sub = sub[sub[col] == val]
+        return float(sub.y_value.iloc[0])
+
+    def test_pjm_vintage_anchors_match_published(self):
+        # UCAP net-CONE ($/MW-day × 365/1000) for every PJM vintage.
+        for dy in (
+            "2021/2022",
+            "2022/2023",
+            "2023/2024",
+            "2024/2025",
+            "2025/2026",
+            "2026/2027",
+            "2027/2028",
+        ):
+            rows = self._rows("PJM", dy)
+            ncd = self._scalar(rows, "net_cone", y_unit="usd_per_mw_day")
+            v = MARKET_DESIGN_VINTAGES["PJM"][dy]
+            self.assertAlmostEqual(
+                v.net_cone_per_kw_yr, ncd * 365.0 / 1000.0, places=3, msg=dy
+            )
+        # The two normalizable PJM vintages: cap = price_cap / net_cone.
+        for dy in ("2026/2027", "2027/2028"):
+            rows = self._rows("PJM", dy)
+            cap = self._scalar(rows, "price_cap", y_unit="usd_per_mw_day")
+            ncd = self._scalar(rows, "net_cone", y_unit="usd_per_mw_day")
+            v = MARKET_DESIGN_VINTAGES["PJM"][dy]
+            self.assertAlmostEqual(
+                v.demand_curve[0].price_frac_net_cone, cap / ncd, places=3, msg=dy
+            )
+
+    def test_neiso_vintage_anchors_and_caps_match_published(self):
+        # anchor = net_cone $/kW-month × 12; cap = price_cap / net_cone.
+        for dy, v in MARKET_DESIGN_VINTAGES["NEISO"].items():
+            rows = self._rows("NEISO", dy)
+            ncm = self._scalar(rows, "net_cone")
+            cap = self._scalar(rows, "price_cap")
+            self.assertAlmostEqual(v.net_cone_per_kw_yr, ncm * 12.0, places=2, msg=dy)
+            self.assertAlmostEqual(
+                v.demand_curve[0].price_frac_net_cone, cap / ncm, places=3, msg=dy
+            )
+
