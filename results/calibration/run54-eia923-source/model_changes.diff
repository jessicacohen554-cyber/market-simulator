+def _coal_class_for(plant_code: int, fuel_code: str = "") -> str:
+    """Return the model coal class (``COAL_LIGNITE`` / ``COAL_PRB`` /
+    ``COAL_BIT`` / ``COAL_WC``) for a coal plant.
