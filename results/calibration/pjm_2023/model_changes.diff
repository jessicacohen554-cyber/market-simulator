+    if "Total interchange" in df.columns:
+        interchange = df["Total interchange"].interpolate().bfill().ffill()
+        if not interchange.isna().any():
+            out["interchange"] = _pad_to_year(interchange.to_numpy(dtype=float))
+    return out or None
