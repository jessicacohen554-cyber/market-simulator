# Local compatibility shim: symlinks (inputs/ -> data/raw/...) so tooling that
# still records the pre-W1-relocation inputs/ paths in old bundle configs can
# resolve them; never a committed artifact.
/inputs/

# Calibration bundles are committed slim (input/summary parquets only): the
# per-hour dispatch dir and system.parquet are large regenerable intermediates
# (the dashboard bakes their metrics into frontend/data/backcast/runs/<id>.js),
# matching the registered bundles (e.g. ercot_dam_offers_cconly_3yr).
results/calibration/*/dispatch/
# per-pass min-gen floors + mechanism ids (legitimacy diagnostics D-2/D-4) —
# large regenerable intermediates, rebuilt via run_year(fleet_only=True).
results/calibration/*/floors/
results/calibration/*/*/floors/
results/calibration/*/system.parquet
# Solve console log — regenerable (the report reproduces via --report DIR); keep bundles slim.
results/calibration/*/solve.log
# capdel probe replay-driver console logs (regenerable; the bundle records the config).
results/calibration/*-capdel-probe.log
# Storage series and the post-solve RCPF/scarcity overlay outputs (availability
# reconstruction + scarcity adder) are regenerable from the bundle via
# scripts/derive_*_rcpf_overlay.py — scratch, never committed.
results/calibration/*/storage.parquet
results/calibration/*/btm.parquet
results/calibration/*/availability_rcpf*.parquet
results/calibration/*/scarcity*.parquet
# ISO-scoped bundle layout (run_calibration_full default out-dir is now
# results/calibration/<ISO>/<name>/ — one level deeper than the flat bundles
# above, so the single-* patterns miss it). Mirror the slim-bundle ignores at
# the two-level depth; only the 4 text files (meta/run_config/SUMMARY/diff) and
# the dashboard payload are committed, never the regenerable parquets/_shared.
results/calibration/*/*/dispatch/
results/calibration/*/*/system.parquet
results/calibration/*/flows.parquet
results/calibration/*/*/flows.parquet
results/calibration/*/*/solve.log
results/calibration/*/*/storage.parquet
results/calibration/*/*/btm.parquet
results/calibration/*/*/availability_rcpf*.parquet
results/calibration/*/*/scarcity*.parquet
results/calibration/*/_shared/
# run131 same-extract baseline re-run: gate-only scratch, not registered.
results/calibration/ercot_dam_cconly_rerun_3yr/
# Shared input cache written by calibration runs (scratch).
/results/calibration/_shared/

# Curated clean tree is DERIVED and disposable: regenerated from data/raw by the
