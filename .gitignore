# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Per-ISO EIA-860 override CSVs — raw source files (parquet/json) are committed
data/raw/eia-860/*.csv

# Derived binned-fleet cache (side output of the fleet loader)
data/raw/_processed-legacy/*.parquet
# The EIA-923 extracts ARE committed: they are small (~16 KB cost,
# ~225 KB generation) and produced once by
# scripts/process_f923_fuel_costs.py; the dispatch fuel resolver and
# the calibration diagnostic read them at runtime.
!data/raw/_processed-legacy/eia923_monthly_fuel_costs.parquet
!data/raw/_processed-legacy/eia923_monthly_generation.parquet
# Derived CAMPD reference artifacts — per-plant parasitic-load factors and
# emission rates, read at runtime by the dispatch LP and calibration report.
!data/raw/_processed-legacy/parasitic_load_factors.parquet
!data/raw/_processed-legacy/plant_emission_rates.parquet
# Per-year EIA-860 plant-level CHP flag lookup (~0.5 MB), produced by
# scripts/build_eia860_chp_by_year.py from the committed EIA-860 release zips.
# The fleet loader reads it so a multi-year backcast buckets each year's gas
# cogens with that year's CHP designation instead of the latest snapshot's.
!data/raw/_processed-legacy/eia860_chp_by_year.parquet

# Generated backcast dashboard files — assembled from the committed registry
# sidecars + bench parts by scripts/build_manifest.py (locally for preview, in
# the Pages deploy for the live site). Never commit them: keeping them out of
# git is what lets concurrent calibration sessions merge without conflicts.
/backcast-results.html
/frontend/data/backcast/manifest.js
/frontend/data/backcast/benchmark.js

# Class-totals cache for scripts/derive_offer_curve_jacobian.py (rebuilt on
# demand from the calibration bundles; the CSV it derives IS committed)
data/raw/_processed-legacy/.offer_curve_jacobian_cache.json

# OS
.DS_Store

# Stray root-level download archives (extract into data/raw/ instead)
/*.zip

# warm-start solver benchmark output (generated by scripts/bench_warmstart.py)
/results/warmstart_bench.txt
/results/calibration/_cold_2023/
/results/calibration/_warm_2023/
/results/calibration/caiso_reprice_pass*/
/results/calibration/caiso_probe2_*/
/results/calibration/caiso_tune*/
/results/calibration/caiso_hydro*/
# NYISO scratch backcasts: Step-1 measured-zonal-load re-runs for the
# locational-reserve / interface diagnostics (regenerable; keepers stay
# nyiso_cal_* until the structure is green and keepers are regenerated last).
/results/calibration/nyiso_u3_*/
/results/calibration/caiso_ixshape*/
# Session B (negative curtailable-renewable offers) scratch backcasts.
/results/calibration/caiso_negrenew*/
# CAISO RA must-offer gas-floor scratch backcasts (Session A frac sweep +
# 3-yr keeper) and its matched no-floor+repin baseline; regenerable from
# --caiso-gas-commitment-floor.
/results/calibration/caiso_floor*/
/results/calibration/caiso_base_repin*/
/results/calibration/nyiso_ce_*/
# CAISO import-ladder diagnosis scratch backcasts (2026-06-19): the keeper-config
# baseline + import re-price sensitivity probes behind the
# DIAGNOSIS-caiso-import-ladder doc. Regenerable from run_calibration_full /
# scripts/_caiso_import_probe.py.
/results/calibration/caiso_keeper_*/
/results/calibration/caiso_probe_*/
# _shared/ holds the hashed input parquets the scratch calibration runs write
# (campd/eia923/eia930); nothing under it is tracked.
/results/calibration/_shared/
/results/calibration/nyiso_oc_*/
# CAISO AS operating-reserve formula before/after bundles (regenerable via
# run_config.json; the before/after is reported, the parquet is scratch).
/results/calibration/caiso_asformula_*/

# Forecast / scenario run caches: transient per-ISO LP outputs keyed by
# cache_key (results/<ISO>/<cache_key>/). Only results/calibration/ bundles
# are tracked; capacity-expansion forecast runs are reproducible from config.
/results/ERCOT/
/results/CAISO/
/results/PJM/
/results/MISO/
/results/SPP/
/results/NYISO/
/results/NEISO/

# run119 dispatch parquets too large for the push endpoint (dashboard renders from the payload; regen via run_config.json)

# run119 bundle kept local only (push endpoint caps payload size); dashboard renders from the committed run payload, bundle reproducible via run_config.json
results/calibration/run119_cps_mustrun/
results/calibration/run119_cps_mustrun.log
data/raw/NYISO-AS/raw/
/results/calibration/pjm_29_20*/
# Intermediate per-year reference-price (pjm_30) run bundles; only the merged
# 3-year results/calibration/pjm_30 is committed (after the interface-limit fix).
/results/calibration/pjm_30_20*/
