# User-provided intake and generated results are not versioned.
data/inputs/*
!data/inputs/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Generated sample inputs (re-created by examples/run_sample_sweep.py).
data/sample/sample_load.csv
data/sample/sample_lmp.csv

# Real per-ISO CF profiles are built from the market-sim data tree by
# scripts/build_profiles.py (large, reproducible, disposable). The only
# committed profile is the tiny data-free fixture under tests/fixtures/.
data/profiles/*
!data/profiles/.gitkeep

# Real per-ISO-year hourly fossil-average CO2-rate exports are built from
# cached market-sim dispatch results by scripts/build_fossil_avg_co2_rate.py
# (ADR 0013; reproducible, disposable). Tests use synthetic in-test fixtures.
data/emissions/*
!data/emissions/.gitkeep

# Stylized reference load (ADR-ratification facility), built deterministically
# by scripts/make_reference_load.py. At ~2 MB (52560 rows: 6 ISOs x 8760h) it
# is over the repo's small-file commit guideline, so it's regenerated on
# demand (examples/run_real_sweep.py does this automatically) rather than
# committed; the generator is the source of truth.
data/reference/*
!data/reference/.gitkeep

# Full-8760 fillable skeleton templates, generated on demand by
# scripts/make_input_templates.py (HP-01). The small illustrative examples
# under data/templates/ (a few rows each) stay committed; these full-size
# skeletons are reproducible and disposable.
data/templates/skeletons/*
!data/templates/skeletons/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Desktop launcher (ADR 0016): saved configs + last-used values persist
# server-side as JSON under launcher/ — user/machine-specific, not versioned.
launcher/saved_configs.json
launcher/last_used.json
