@@ -0,0 +1,362 @@
+"""miso-160: the measured seasonal forced-outage shape replacing SUMMER_WEFOR_SHARE.
+
+PREREG: results/calibration/PREREG-miso160-summer-wefor-measured-share-2026-08-16.md
+(commit a96702b, blob 57d2b8b1, byte-verified against the fetched remote ref
+BEFORE this file was written).
+
+Two legs, run as ``derive`` / ``reach`` subcommands (default: whichever is
+runnable — ``reach`` needs the ``summer_wefor_share_override`` field to exist):
+
+* ``derive`` (PREREG §2, Phase 0 — runs BEFORE the implementation): the
+  adjudicating statistic, fixed in the PREREG before it was computed.
+  ``R*_y = mean(offline MW, Jun-Sep) / mean(offline MW, annual)`` per year,
+  region "MISO", cause types ``UNPLANNED_CAUSE_TYPES`` (Derated/Forced/
+  Unplanned — the miso-85 composition, miso-157's adjudicating basis),
+  through the PRODUCTION loader ``miso_outage_mw_series`` (T-8). Pooled
+  ``R* = mean(R*_2023..2025)`` rounded to 4 decimals — the armed override
+  value. V1: each ``R*_y`` reproduces miso-157's published composite
+  1.104/0.967/1.109 to ±0.01. S-DERIVE: pooled R* inside [1.00, 1.12].
+  Companions (reported, never adjudicating): per-bucket and per-region
+  ratios, Jun+Jul window (T-29), covered-day counts.
+
+* ``reach`` (PREREG §4/§5, Phase 1 — runs AFTER the implementation): builds
+  the keeper fleet's availability arrays under the control config and the
+  armed config (``summer_wefor_share_override = R*``) via the production
+  chain (``_miso134.build_year`` repointed to the miso-159 keeper bundle),
+  and measures: V3 fleet identity (n_gen, 6 carry zones); V4a winter
+  invariance (|arm - control| == 0 in every winter hour, all units); V4b the
+  analytic per-unit annual-mean conservation identity (≤1e-9); V4c the
+  final-array annual-mean deviation per class (REPORTED — the multiplicative
+  overlay/ambient interactions make exact zero impossible there; not gated);
+  P-2 reach — summer (Jun-Sep) and top-200-Jun-Sep-demand-hour capability
+  delta per class, GW.
+
+T-2: zero 3-argument ``getattr`` in this probe. T-3: exact constants and
+clean zeros get a second derivation before they are believed.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+REPO = Path(__file__).resolve().parents[2]
+for _p in (str(REPO), str(REPO / "src"), str(REPO / "scripts" / "probes")):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import _miso134_ct_night_order_screen as _m134  # noqa: E402
+
+# T-1: _miso134 is hard-wired to another bundle. Repoint to THIS lane's keeper
+# (the miso-159 arm bundle) and assert before anything reads it.
+BUNDLE = REPO / "results/calibration/miso159_cod_B"
+if not (BUNDLE / "run_config.json").is_file():
+    raise SystemExit(f"keeper bundle missing: {BUNDLE}")
+_m134.BUNDLE = BUNDLE
+assert _m134.BUNDLE == BUNDLE, "T-1: bundle repoint failed"
+
+from _miso134_ct_night_order_screen import keeper_config  # noqa: E402
+from market_sim.config.fuel_trajectories import (  # noqa: E402
+    SUMMER_WEFOR_SHARE,
+)
+from market_sim.data.fleet.arrays import (  # noqa: E402
+    _CC_SHOULDER_MONTHS,
+    _SUMMER_MONTHS,
+)
+from market_sim.data.miso_outages import (  # noqa: E402
+    CAUSE_TYPES,
+    REGIONS,
+    UNPLANNED_CAUSE_TYPES,
+    miso_outage_mw_series,
+)
+
+# T-8: the outage series must come from the production loader.
+assert (
+    miso_outage_mw_series.__module__ == "market_sim.data.miso_outages"
+), "T-8: miso_outage_mw_series is not the production loader"
+assert UNPLANNED_CAUSE_TYPES == ("Derated", "Forced", "Unplanned")
+
+YEARS = (2023, 2024, 2025)
+HOURS = 8760
+
+# miso-157 §4, published — the V1 reproduction targets (composite, Jun-Sep).
+V1_COMPOSITE = {2023: 1.104, 2024: 0.967, 2025: 1.109}
+V1_TOL = 0.01
+# PREREG §6 S-DERIVE hard band for the pooled value.
+S_DERIVE_BAND = (1.00, 1.12)
+# miso-155/156/159, published — the V3 fleet census.
+V3_NGEN = {2023: 2929, 2024: 2923, 2025: 2923}
+CARRY_ZONES = 6
+
+RECORD = REPO / "results/calibration/_miso160_wefor_shape_instrument.json"
+
+
+def _month_of_hour(year: int) -> np.ndarray:
+    """Month 1-12 per hour of the model's fixed non-leap 8760 clock.
+
+    THE PRODUCTION CLOCK (T-8), not a real-calendar ``date_range``: the model
+    maps every year — leap years included — onto a representative non-leap
+    calendar (``models._hour_to_month_index``), and the outage loader
+    broadcasts onto the same clock (``outages._hour_of_year``). The probe's
+    first build used the real 2024 calendar and mis-labelled 240 hours,
+    which fired V4a for 2024 (S-CONSERVE; disclosed in the FINDING) — the
+    defect was the instrument's, not the implementation's.
+    """
+    from market_sim.data.fleet.models import _hour_to_month_index
+
+    del year  # the model clock is year-invariant by construction
+    return _hour_to_month_index(HOURS) + 1
+
+
+def _masks(year: int) -> dict[str, np.ndarray]:
+    m = _month_of_hour(year)
+    summer = np.isin(m, sorted(_SUMMER_MONTHS))
+    shoulder = np.isin(m, sorted(_CC_SHOULDER_MONTHS))
+    return {
+        "summer": summer,
+        "shoulder": shoulder,
+        "winter": ~summer & ~shoulder,
+        "junjul": np.isin(m, [6, 7]),
+    }
+
+
+def _ratio(series: np.ndarray, mask: np.ndarray) -> float:
+    ann = float(series.mean())
+    if ann <= 0.0:
+        return float("nan")
+    return float(series[mask].mean() / ann)
+
+
+def derive() -> dict:
+    """Phase 0: the adjudicating statistic, exactly as fixed in PREREG §2."""
+    out: dict = {
+        "basis": {
+            "region": "MISO",
+            "cause_types": list(UNPLANNED_CAUSE_TYPES),
+            "window": sorted(_SUMMER_MONTHS),
+            "loader": "market_sim.data.miso_outages.miso_outage_mw_series",
+        },
+        "years": {},
+    }
+    r_years: list[float] = []
+    for year in YEARS:
+        ms = _masks(year)
+        comp = miso_outage_mw_series(year, "MISO", UNPLANNED_CAUSE_TYPES)
+        # Covered-day count: days with a nonzero daily total (the loader
+        # leaves uncovered days at 0.0, which would bias the annual mean).
+        daily = comp.reshape(365, 24).sum(axis=1)
+        covered = int((daily > 0.0).sum())
+        r_junsep = _ratio(comp, ms["summer"])
+        y: dict = {
+            "R_junsep_composite": r_junsep,
+            "R_junjul_composite": _ratio(comp, ms["junjul"]),
+            "annual_mean_offline_mw": float(comp.mean()),
+            "covered_days_nonzero": covered,
+            "V1_target": V1_COMPOSITE[year],
+            "V1_delta": r_junsep - V1_COMPOSITE[year],
+            "V1_pass": bool(abs(r_junsep - V1_COMPOSITE[year]) <= V1_TOL),
+            "per_bucket": {},
+            "per_region_composite": {},
+        }
+        for cause in CAUSE_TYPES:
+            s = miso_outage_mw_series(year, "MISO", (cause,))
+            y["per_bucket"][cause] = {
+                "R_junsep": _ratio(s, ms["summer"]),
+                "R_junjul": _ratio(s, ms["junjul"]),
+                "annual_mean_mw": float(s.mean()),
+            }
+        for region in REGIONS:
+            s = miso_outage_mw_series(year, region, UNPLANNED_CAUSE_TYPES)
+            y["per_region_composite"][region] = _ratio(s, ms["summer"])
+        out["years"][str(year)] = y
+        r_years.append(r_junsep)
+
+    pooled = round(float(np.mean(r_years)), 4)
+    out["pooled_R_star"] = pooled
+    out["pooled_band_P1"] = [1.04, 1.08]
+    out["s_derive_band"] = list(S_DERIVE_BAND)
+    out["V1_pass_all"] = bool(
+        all(out["years"][str(y)]["V1_pass"] for y in YEARS)
+    )
+    out["S_DERIVE_fired"] = bool(
+        not (S_DERIVE_BAND[0] <= pooled <= S_DERIVE_BAND[1])
+        or not out["V1_pass_all"]
+    )
+    return out
+
+
+def _keeper_demand(year: int) -> np.ndarray:
+    """(T,) ISO demand from the keeper bundle's committed system parquet."""
+    sysf = pd.read_parquet(BUNDLE / f"hourly/system_{year}.parquet")
+    sysf = sysf[sysf["pass"] == "P1"]
+    return (
+        sysf.pivot_table(index="hour", columns="zone", values="demand")
+        .sum(axis=1)
+        .to_numpy()
+    )
+
+
+def reach(r_star: float) -> dict:
+    """Phase 1 (post-implementation): V3/V4 gates + P-2 reach, arm - control."""
+    from market_sim.config.fuel_trajectories import THERMAL_AVAILABILITY
+    from market_sim.data.fleet.arrays import _thermal_outage
+
+    assert (
+        _thermal_outage.__module__ == "market_sim.data.fleet.arrays"
+    ), "T-8: _thermal_outage is not the production function"
+    cfg = keeper_config()
+    assert cfg.summer_wefor_share_override is None, (
+        "control config must carry the field at its default"
+    )
+    out: dict = {"r_star": r_star, "years": {}}
+    for year in YEARS:
+        cfg_ctl = dataclasses.replace(cfg, weather_year=year)
+        cfg_arm = dataclasses.replace(
+            cfg, weather_year=year, summer_wefor_share_override=r_star
+        )
+        _, fleet_c, arr_c, _, _, zone_names = _m134.build_year(cfg_ctl, year)
+        _, fleet_a, arr_a, _, _, zn_a = _m134.build_year(cfg_arm, year)
+
+        # V3: fleet identity, both arms; 6 carry zones (T-5).
+        n_c, n_a = len(fleet_c), len(fleet_a)
+        carry = [z for z in zone_names if not z.startswith("MISO_external")]
+        v3 = {
+            "n_gen_control": n_c,
+            "n_gen_arm": n_a,
+            "n_gen_expected": V3_NGEN[year],
+            "carry_zones": len(carry),
+            "pass": bool(
+                n_c == n_a == V3_NGEN[year]
+                and len(carry) == CARRY_ZONES
+                and zone_names == zn_a
+            ),
+        }
+
+        ms = _masks(year)
+        d = arr_a.availability - arr_c.availability
+        pmax = arr_c.pmax
+        labels = np.array(
+            [str(g.plant_group) for g in fleet_c], dtype=object
+        )
+
+        # V4a: winter hours are untouched by construction — for EVERY unit.
+        v4a_max = float(np.abs(d[:, ms["winter"]]).max())
+
+        # V4b: the rebuilt per-unit share-term composition (pre-overlay, the
+        # miso-157 leg-2 instrument): with dsummer = (r*-0.30)*wefor_unit and
+        # dshoulder = -(r*-0.30)*wefor_unit*(summer_h/shoulder_h), the annual
+        # mean must be invariant: |summer_h*dsummer + shoulder_h*dshoulder| /
+        # 8760 <= 1e-9 for EVERY unit in the share population, at each unit's
+        # own age-based WEFOR from the production _thermal_outage.
+        sh, shh = int(ms["summer"].sum()), int(ms["shoulder"].sum())
+        s2s = sh / shh
+        v4b_max = 0.0
+        for g in fleet_c:
+            grp = str(g.plant_group)
+            if grp not in THERMAL_AVAILABILITY or g.fuel_type == "coal":
+                continue
+            _, wef, _ = _thermal_outage(grp, year - g.online_year)
+            ds = (r_star - SUMMER_WEFOR_SHARE) * wef
+            dsh = -(r_star - SUMMER_WEFOR_SHARE) * wef * s2s
+            v4b_max = max(v4b_max, abs(sh * ds + shh * dsh) / HOURS)
+
+        # V4c (REPORTED, not gated): final-array annual-mean deviation per
+        # class, pmax-weighted GW — the overlay/ambient interaction residue.
+        # P-2: summer capability delta per class, and at the top-200
+        # Jun-Sep demand hours.
+        demand = _keeper_demand(year)
+        junsep_idx = np.where(ms["summer"])[0]
+        top200 = junsep_idx[np.argsort(demand[junsep_idx])[-200:]]
+        per_class: dict = {}
+        for grp in sorted(set(labels)):
+            gi = np.where(labels == grp)[0]
+            if not len(gi):
+                continue
+            dsub, w = d[gi], pmax[gi]
+            per_class[grp] = {
+                "annual_gw": float((dsub.mean(axis=1) * w).sum() / 1e3),
+                "summer_gw": float(
+                    (dsub[:, ms["summer"]].mean(axis=1) * w).sum() / 1e3
+                ),
+                "top200_junsep_gw": float(
+                    (dsub[:, top200].mean(axis=1) * w).sum() / 1e3
+                ),
+            }
+        tot = {
+            k: float(sum(v[k] for v in per_class.values()))
+            for k in ("annual_gw", "summer_gw", "top200_junsep_gw")
+        }
+        out["years"][str(year)] = {
+            "V3": v3,
+            "V4a_winter_max_abs_delta": v4a_max,
+            "V4a_pass": bool(v4a_max == 0.0),
+            "V4b_analytic_conservation_max": v4b_max,
+            "V4b_pass": bool(v4b_max <= 1e-9),
+            "V4c_final_array_annual_by_class_gw": {
+                k: v["annual_gw"] for k, v in per_class.items()
+            },
+            "P2_reach_by_class": per_class,
+            "P2_reach_total": tot,
+        }
+        del fleet_c, fleet_a, arr_c, arr_a, d
+    return out
+
+
+def main() -> None:
+    args = set(sys.argv[1:])
+    rec: dict = {}
+    if RECORD.exists():
+        rec = json.loads(RECORD.read_text())
+    rec.setdefault(
+        "prereg", "PREREG-miso160-summer-wefor-measured-share-2026-08-16.md"
+    )
+    rec.setdefault("prereg_commit", "a96702b")
+    rec.setdefault("prereg_blob", "57d2b8b1")
+    rec["bundle"] = BUNDLE.name
+    rec["share_replaced"] = float(SUMMER_WEFOR_SHARE)
+
+    if not args or "derive" in args:
+        rec["derive"] = derive()
+        print(
+            json.dumps(
+                {
+                    "pooled_R_star": rec["derive"]["pooled_R_star"],
+                    "V1_pass_all": rec["derive"]["V1_pass_all"],
+                    "S_DERIVE_fired": rec["derive"]["S_DERIVE_fired"],
+                    "per_year": {
+                        y: rec["derive"]["years"][y]["R_junsep_composite"]
+                        for y in rec["derive"]["years"]
+                    },
+                },
+                indent=2,
+            )
+        )
+    if "reach" in args:
+        if "derive" not in rec:
+            raise SystemExit("run derive first — reach arms its pooled value")
+        rec["reach"] = reach(float(rec["derive"]["pooled_R_star"]))
+        print(
+            json.dumps(
+                {
+                    y: {
+                        "V3": rec["reach"]["years"][y]["V3"]["pass"],
+                        "V4a": rec["reach"]["years"][y]["V4a_pass"],
+                        "V4b": rec["reach"]["years"][y]["V4b_pass"],
+                        "total": rec["reach"]["years"][y]["P2_reach_total"],
+                    }
+                    for y in rec["reach"]["years"]
+                },
+                indent=2,
+            )
+        )
+    RECORD.write_text(json.dumps(rec, indent=2, default=float))
+    print(f"wrote {RECORD}")
+
+
+if __name__ == "__main__":
+    main()
