+# ---------------------------------------------------------------------------
+# PJM input-clock repair (M-1, docs/DIAGNOSIS-pjm-2025-phase-drift-and-zonal-
+# structure-2026-07.md §1b/§6).  Two independent clock defects in the committed
+# ``PJM hourly.parquet`` are corrected by a *value-preserving* re-placement --
+# each affected cell keeps its measured value and only moves to the UTC hour it
+# actually belongs to (no re-pull, no interpolation, no tuning; rule 13/14):
+#
+#   * REGION family (Demand forecast / Demand / Net generation / Total
+#     interchange) in the **2023** vintage was built one position LATE (an
+#     hour-beginning/hour-ending label mix-up in that year's extract
+#     construction; verified: 2023 rows are value-identical to the EIA-930
+#     BALANCE archive placed hour-ending [T-1h,T) but shifted +1 slot).  Fix:
+#     shift the 2023 region family -1 h so it sits hour-ending [T-1h,T) like
+#     2024/2025 (which already match BALANCE at shift 0).  The 2023 demand then
+#     aligns with PJM's own ``hrl_load_metered`` (best-lag 0, was -1).
+#
+#   * FUELTYPE family (all ``NG:`` columns) ran one hour EARLY at the EIA-930
+#     source through 2024 (fixed upstream ~Feb-2025; July solar centroid ~10.9
+#     vs the astronomically-fixed ~11.9).  In **2024** the wide extract sits on
+#     the raw (early) source clock, so its fueltype is 1 h early.  Fix: shift
+#     the 2024 fueltype family +1 h.  In **2023** the source's 1 h-early and the
+#     extract's 1 h-late errors cancelled, so 2023 fueltype is already aligned
+#     (centroid 11.9) and is KEPT.  **2025** is aligned from ~Feb (source fixed)
+#     and is left untouched; January-2025 straddles the upstream switch
+#     (centroid 11.15) and is left as measured -- correcting a sub-month straddle
+#     would require fabricating a switch hour (rule 14), so it is documented, not
+#     shifted.
+#
+# Net per-family effect vs the pre-fix committed file: 2023 demand -1 h, 2023
+# fueltype 0, 2024 demand 0, 2024 fueltype +1 h, 2025 0.  Every other cell, row,
+# dtype and column is byte-identical.  This is a source-data placement action
+# (rule 23) citing the diagnosis, not a residual fit.
+_PJM_REGION_FAMILY: tuple[str, ...] = (
+    "Demand forecast",
+    "Demand",
+    "Net generation",
+    "Total interchange",
+)
+_PJM_INPUT_CLOCK_SHIFTS: tuple[tuple[int, str, int], ...] = (
+    # (local-date year, family, hours to move the CONTENT: -1 = earlier)
+    (2023, "region", -1),
+    (2024, "fueltype", +1),
+)
+
+
+def _replace_family_by_utc_shift(
+    df: pd.DataFrame, year: int, cols: list[str], content_shift_h: int
+) -> pd.DataFrame:
+    """Move ``cols`` for local-year ``year`` rows by ``content_shift_h`` hours.
+
+    Value-preserving: the new value at a row whose UTC hour is ``T`` is the
+    committed value currently at ``T - content_shift_h`` (so a ``-1`` shift
+    pulls each cell's content one hour EARLIER onto its row, and ``+1`` pulls it
+    one hour later).  Sourced from the same committed frame (which spans
+    2018-2026 contiguously), so a year-boundary row reads its immediate UTC
+    neighbour and no NaN is introduced inside ``year``.  The row grid, the time
+    columns, and every cell outside (``year``, ``cols``) are untouched.
+
+    Args:
+        df: The full multi-year wide extract (UTC-unique).
+        year: Local-date calendar year whose ``cols`` are re-placed.
+        cols: Value columns to move (a region- or fueltype-family list).
+        content_shift_h: Signed hours to move the content (-1 earlier / +1 later).
+
+    Returns:
+        A copy of ``df`` with only the (``year``, ``cols``) block re-placed.
+    """
+    out = df.sort_values("UTC time").reset_index(drop=True).copy()
+    utc = pd.DatetimeIndex(out["UTC time"])
+    by_utc = out.set_index("UTC time")
+    # Row T takes the committed value at UTC (T - content_shift_h).
+    src_utc = utc - pd.Timedelta(hours=content_shift_h)
+    src = by_utc[cols].reindex(src_utc).reset_index(drop=True)
+    mask = (out["Local date"].dt.year == year).to_numpy()
+    for col in cols:
+        arr = out[col].to_numpy().copy()
+        arr[mask] = src[col].to_numpy()[mask]
+        out[col] = arr.astype(df[col].dtype)
+    return out
+
+
+def rebuild_pjm_input_clock(force: bool) -> Path:
+    """Apply the M-1 per-family input-clock re-placement to ``PJM hourly.parquet``.
+
+    Reads the committed wide extract, applies :data:`_PJM_INPUT_CLOCK_SHIFTS`
+    (2023 region -1 h; 2024 fueltype +1 h) as value-preserving UTC-time
+    re-placements, and writes the corrected extract back in the identical
+    schema.  See the module-level notes above and
+    ``docs/DIAGNOSIS-pjm-2025-phase-drift-and-zonal-structure-2026-07.md`` §6.
+    """
+    out_path = OUT_DIR / "PJM hourly.parquet"
+    df = pd.read_parquet(out_path)
+    original_cols = list(df.columns)
+    fuel_cols = [c for c in df.columns if c.startswith("NG: ")]
+    region_cols = [c for c in _PJM_REGION_FAMILY if c in df.columns]
+    for year, family, shift in _PJM_INPUT_CLOCK_SHIFTS:
+        cols = region_cols if family == "region" else fuel_cols
+        df = _replace_family_by_utc_shift(df, year, cols, shift)
+        print(
+            f"  PJM {year} {family} family: content shifted {shift:+d} h ({len(cols)} cols)"
+        )
+    df = df[original_cols]
+    if not force:
+        tmp = out_path.with_suffix(".parquet.new")
+        df.to_parquet(tmp, index=False)
+        tmp.replace(out_path)
+    else:
+        df.to_parquet(out_path, index=False)
+    print(f"  -> wrote {out_path}")
+    return out_path
+
+
